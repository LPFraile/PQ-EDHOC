{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build for nRF52840 DK nRF52840",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf52840dk/nrf52840",
                "CONF_FILE": "prj_dilithium_clean.conf",
                "DEBUG_THREAD_INFO": true,
                "CONFIG_DEBUG_THREAD_INFO": false,
                "USE_SUIT_12": "ON",
                "USE_X5T": "1",
                "USE_CLEAN_IMP": "1"
            }
        }
    ]
}